#!/usr/bin/env bash
# Local half of the no-writes-to-main rule. Self-contained on purpose: a fresh
# worktree may not have bin/ yet, and a hook that errors for the wrong reason
# is worse than no hook - it passes for the wrong reason too.
# Server-side branch protection is the authority; this is an early warning,
# and it names only the protected branches. A detached HEAD is not one:
# fm-worker.sh rebuilds a branch there (T-093).
: "${FM_PROTECTED:=main master}"
# a target's managed clone names its project's base (bin/fm-project.sh sync)
base=$(git config --local --get firstmate.base 2>/dev/null || true)
b=$(git branch --show-current 2>/dev/null)
for p in $FM_PROTECTED $base; do
  if [ "$b" = "$p" ]; then
    echo "fm-guard: refusing to commit on $b." >&2
    echo '          branch first, then open a pull request.' >&2
    exit 1
  fi
done
exit 0

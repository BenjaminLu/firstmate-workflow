#!/usr/bin/env bash
# Local half of the no-writes-to-main rule. Self-contained on purpose: a fresh
# worktree may not have bin/ yet, and a hook that errors for the wrong reason
# is worse than no hook - it passes for the wrong reason too.
: "${FM_PROTECTED:=main master}"
b=$(git branch --show-current 2>/dev/null)
if [ -z "$b" ]; then
  echo 'fm-guard: detached HEAD - refusing to commit' >&2; exit 1
fi
for p in $FM_PROTECTED; do
  if [ "$b" = "$p" ]; then
    echo "fm-guard: refusing to commit on $b." >&2
    echo '          branch first, then open a pull request.' >&2
    exit 1
  fi
done
exit 0
